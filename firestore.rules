rules_version = '2';
// Masa (מסע) · who may read and write what. Everything not allowed here is refused.
// Tested by tools/firebase/rules.test.mjs (runs in GitHub Actions on every change).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function str(v, n) { return v is string && v.size() <= n; }
    function optStr(d, k, n) { return !(k in d) || str(d[k], n); }

    // A profile: only its owner reads or writes it.
    match /users/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'prefs', 'updatedAt'])
        && str(request.resource.data.name, 80)
        && optStr(request.resource.data, 'photo', 500)
        && optStr(request.resource.data, 'prefs', 4000)
        && request.resource.data.updatedAt == request.time;
    }

    // A trip: its members read it; members edit the plan and their own notes.
    match /trips/{tripId} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function shape(d) {
        return d.keys().hasOnly(['owner', 'members', 'names', 'data', 'fam', 'updatedAt', 'joinCode', 'v'])
          && d.owner is string && d.members is list && d.members.size() >= 1 && d.members.size() <= 20
          && d.names is map && d.names.size() <= 20
          && d.data is string && d.data.size() <= 400000
          && d.fam is map && d.fam.size() <= 20
          && d.updatedAt == request.time;
      }
      function onlyMine(field) {
        return request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid]);
      }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      allow read: if isMember();
      allow create: if signedIn() && shape(request.resource.data)
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && !('joinCode' in request.resource.data);
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // a member edits the plan, their own notes and their own name; who is in the trip stays the same
      allow update: if isMember() && shape(request.resource.data)
        && changed().hasOnly(['data', 'fam', 'names', 'updatedAt', 'v'])
        && onlyMine('fam') && onlyMine('names');

      // joining with an invite: add yourself and nothing else
      allow update: if signedIn() && !(request.auth.uid in resource.data.members)
        && shape(request.resource.data)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && changed().hasOnly(['members', 'names', 'joinCode', 'updatedAt'])
        && onlyMine('names')
        && exists(/databases/$(db)/documents/invites/$(request.resource.data.joinCode))
        && get(/databases/$(db)/documents/invites/$(request.resource.data.joinCode)).data.tripId == tripId;

      // leaving: a member (not the owner) removes themselves and their notes
      allow update: if isMember() && request.auth.uid != resource.data.owner
        && shape(request.resource.data)
        && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        && changed().hasOnly(['members', 'names', 'fam', 'updatedAt'])
        && onlyMine('fam') && onlyMine('names');

      // the owner may remove members (never add them, never give the trip away)
      allow update: if signedIn() && request.auth.uid == resource.data.owner
        && shape(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && resource.data.members.hasAll(request.resource.data.members)
        && request.auth.uid in request.resource.data.members;
    }

    // Feedback ("something did not work?"): anyone may send one short note; nobody can read, change or list them from
    // the site (they are read in the Firebase console).
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'screen', 'city', 'contact', 'at'])
        && str(request.resource.data.text, 1500) && request.resource.data.text.size() >= 3
        && optStr(request.resource.data, 'screen', 30) && optStr(request.resource.data, 'city', 60)
        && optStr(request.resource.data, 'contact', 120)
        && request.resource.data.at == request.time;
    }

    // Anonymous counts: what happened (a trip built, a picture shared), the city and the day. No user, no device id.
    match /events/{id} {
      allow create: if request.resource.data.keys().hasOnly(['e', 'city', 'n', 'at'])
        && request.resource.data.e in ['build', 'share_image', 'share_link', 'kit_open', 'signin', 'guide_ai', 'feedback']
        && optStr(request.resource.data, 'city', 40)
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 30))
        && request.resource.data.at == request.time;
    }

    // An invite: whoever has the (long, random) code may look it up; only the trip owner creates or deletes it.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() >= 20 && code.size() <= 64
        && request.resource.data.keys().hasOnly(['tripId', 'owner', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.createdAt == request.time
        && get(/databases/$(db)/documents/trips/$(request.resource.data.tripId)).data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
